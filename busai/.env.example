# Copy this file to .env and fill in real values.
# NEVER commit .env. It is ignored by .gitignore.
#
# EXPO_PUBLIC_* values are embedded in the app bundle.
# Only use public/client-safe keys here. Never put a Supabase service_role
# key, database password, or other server secret in this file.

# ---------------------------------------------------------------------------
# LTA DataMall
# Used by bus arrivals/routes/stops, service alerts, and other LTA APIs.
# Get an AccountKey from https://datamall.lta.gov.sg/
# ---------------------------------------------------------------------------
EXPO_PUBLIC_LTA_DATAMALL_KEY=

# ---------------------------------------------------------------------------
# Google Maps
# Used by the Home map and route/trip maps.
# Restrict the key to your app bundle IDs and Maps SDKs.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Supabase
# EXPO_PUBLIC_SUPABASE_URL is the project URL, for example:
# https://<project-ref>.supabase.co
# Use the anon/publishable key only. Never the service_role key.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AdMob
# Optional banner ad unit. If omitted, the code falls back to Google's sample
# test unit. Replace with your production unit before release.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=

# ---------------------------------------------------------------------------
# Train data source
# unset  -> development uses the bundled fixture; production uses Supabase
# 0      -> force Supabase (recommended for production/testing real data)
# 1      -> force the bundled fixture (development/UI work only; never ship)
#
# EXPO_PUBLIC_* values are read when the app starts/builds, so restart Expo
# or rebuild after changing this.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_TRAIN_FIXTURE=
